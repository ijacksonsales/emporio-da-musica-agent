# Copy this file to .env and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LLM provider and model (the provider layer makes this swappable)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Used automatically when the main model hits its quota (HTTP 429); leave empty to disable
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# "Today" for the agent. The dataset ends on 2026-03-22, so the default
# reference date sits right after the last order (see docs/DECISION_LOG.md).
REFERENCE_DATE=2026-03-25

# Conversation history retention, in days
HISTORY_TTL_DAYS=7

# SQLite file for conversation history
DB_PATH=var/conversations.sqlite3
